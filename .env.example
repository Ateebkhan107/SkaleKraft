# SkaleKraft Production Environment Variables Example
# Copy this file to .env.local for local development or configure in your deployment dashboard (e.g. Vercel)

# Resend API Key for sending emails (get from https://resend.com)
RESEND_API_KEY=re_1234567890abcdef

# The email address that receives project inquiries submitted through the contact form
CONTACT_EMAIL_TO=hello@skalekraft.in

# The verified sender email address on your Resend domain (can be "hello@skalekraft.in" or "SkaleKraft <hello@skalekraft.in>")
CONTACT_EMAIL_FROM=SkaleKraft <hello@skalekraft.in>

# Optional: The email address that receives job applications submitted through the join form.
# Defaults to CONTACT_EMAIL_TO if not set.
JOIN_EMAIL_TO=hello@skalekraft.in
